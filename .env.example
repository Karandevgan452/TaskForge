# ==============================================================================
# TaskForge Environment Variables Guide
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LOCAL DEVELOPMENT & DOCKER ENVIRONMENT VARIABLES (In .env file)
# ------------------------------------------------------------------------------
# PostgreSQL JDBC Database Connection URL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/taskforge

# Prisma PostgreSQL Database Connection URL (used by Prisma CLI)
DATABASE_URL=postgresql://postgres:password@localhost:5432/taskforge

# Database Credentials (Must match your local Postgres or docker-compose db container)
DB_USERNAME=postgres
DB_PASSWORD=password

# Application Server Port
PORT=8080

# JWT Security Key (Minimum 256-bit secret string)
JWT_SECRET=9a4f2c8d7e1b5a3f6c8e0d2b4a6f8c1d3e5b7a9f0c2d4e6b8a0c2d4e6f8a0b2c
JWT_EXPIRATION_MS=86400000


# ------------------------------------------------------------------------------
# 2. RENDER CLOUD ENVIRONMENT VARIABLES (Set in Render Dashboard -> Web Service -> Environment)
# ------------------------------------------------------------------------------
# DATABASE_URL = postgresql://user:password@ep-xyz.neon.tech/taskforge?sslmode=require
# SPRING_DATASOURCE_URL = jdbc:postgresql://user:password@ep-xyz.neon.tech:5432/taskforge?sslmode=require
# DB_USERNAME = <your-db-username>
# DB_PASSWORD = <your-db-password>
# JWT_SECRET = <your-production-256-bit-secret-key>
# JWT_EXPIRATION_MS = 86400000
# PORT = 8080
# SPRING_PROFILES_ACTIVE = prod


# ------------------------------------------------------------------------------
# 3. GITHUB ACTIONS SECRETS (Set in GitHub Repository -> Settings -> Secrets and variables -> Actions)
# ------------------------------------------------------------------------------
# DOCKER_USERNAME         = <your-docker-hub-username>
# DOCKER_PASSWORD         = <your-docker-hub-access-token>
# RENDER_DEPLOY_HOOK_URL = <your-render-deploy-webhook-url>
# DATABASE_URL             = <production-postgres-db-url-for-prisma-migrations>
