# TaskForge Environment Variables Example

# Database URL (PostgreSQL / Neon DB)
DATABASE_URL=postgresql://user:password@host:5432/taskforge

# Spring Data / JDBC settings
DB_USERNAME=postgres
DB_PASSWORD=password

# JWT Security
JWT_SECRET=your-256-bit-super-secret-key-string-goes-here-min-32-chars
JWT_EXPIRATION_MS=86400000

# Application Server Port
PORT=8080

# Render Deploy Hook URL (for CD Pipeline)
RENDER_DEPLOY_HOOK_URL=https://api.render.com/deploy/srv-xxxxxx?key=yyyyyy

# Docker Hub Credentials (for CD Pipeline secrets)
DOCKER_USERNAME=yourdockerhubusername
DOCKER_PASSWORD=yourdockerhubaccesstoken
